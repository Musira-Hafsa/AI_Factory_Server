# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/support-desk?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# --- Optional ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=7d

# AI triage. If unset, the app falls back to a deterministic keyword-based mock.
# Never expose this key to the frontend.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=15000
